#: app/audio/sintesis.py:373
msgid "agua"
msgstr "water"

#: app/audio/sintesis.py:373
msgid "Un chapoteo: has pisado un charco."
msgstr "A splash: you stepped in a puddle."

#: app/audio/sintesis.py:380
msgid "pavimento táctil de botones"
msgstr "dot tactile paving"

#: app/audio/sintesis.py:381
msgid "Baldosa con un repique doble: avisa de un peligro o de un cruce justo delante."
msgstr "Paving with a double tap: it warns of a hazard or a crossing just ahead."

#: app/audio/sintesis.py:389
msgid "pavimento táctil de rayas"
msgstr "bar tactile paving"

#: app/audio/sintesis.py:390
msgid "Baldosa con un raspado corto: marca un camino que puedes seguir."
msgstr "Paving with a short scrape: it marks a path you can follow."

#: app/audio/sintesis.py:443
#, python-brace-format
msgid "Paso sobre {suelo}, pie {pie}, variante {variante}"
msgstr "Step on {suelo}, {pie} foot, variant {variante}"

#: app/audio/sintesis.py:444
#, python-brace-format
msgid "{como} Lo oyes a tus pies cada vez que das un paso sobre {suelo}."
msgstr "{como} You hear it at your feet every time you take a step on {suelo}."

#: app/audio/sintesis.py:449
msgid "izquierdo"
msgstr "left"

#: app/audio/sintesis.py:449
msgid "derecho"
msgstr "right"

#: app/audio/sintesis.py:458
msgid "ladrillo"
msgstr "brick"

#: app/audio/sintesis.py:461
msgid "cristal"
msgstr "glass"

#: app/audio/sintesis.py:462
msgid "plástico"
msgstr "plastic"

#: app/audio/sintesis.py:463
msgid "tela"
msgstr "fabric"

#: app/audio/sintesis.py:464
msgid "piedra"
msgstr "stone"

#: app/audio/sintesis.py:467
msgid "Un golpe sordo y corto, con algo de arenilla."
msgstr "A short, dull knock, with some grit."

#: app/audio/sintesis.py:468
msgid "Un toc hueco."
msgstr "A hollow tock."

#: app/audio/sintesis.py:469
msgid "Un golpe que se queda sonando, como una chapa."
msgstr "A knock that keeps ringing, like sheet metal."

#: app/audio/sintesis.py:470
msgid "Un toque agudo que tintinea."
msgstr "A high-pitched, tinkling tap."

#: app/audio/sintesis.py:471
msgid "Un clac hueco y ligero."
msgstr "A hollow, light clack."

#: app/audio/sintesis.py:472
msgid "Un golpe blando, casi sin sonido, con un roce."
msgstr "A soft knock, almost silent, with a brush."

#: app/audio/sintesis.py:473
msgid "Un golpe duro y seco."
msgstr "A hard, sharp knock."

#: app/audio/sintesis.py:476
msgid "Un raspado áspero."
msgstr "A rough scrape."

#: app/audio/sintesis.py:477
msgid "Un deslizar suave y algo grave."
msgstr "A smooth, somewhat low slide."

#: app/audio/sintesis.py:478
msgid "Un roce agudo con un punto de chirrido."
msgstr "A high-pitched brush with a hint of squeak."

#: app/audio/sintesis.py:479
msgid "Un roce liso y muy agudo."
msgstr "A smooth, very high-pitched brush."

#: app/audio/sintesis.py:480
msgid "Un roce hueco y ligero."
msgstr "A hollow, light brush."

#: app/audio/sintesis.py:481
msgid "Un siseo blando."
msgstr "A soft hiss."

#: app/audio/sintesis.py:482
msgid "Un raspado duro y granulado."
msgstr "A hard, grainy scrape."

#: app/audio/sintesis.py:551
#, python-brace-format
msgid "Choque con {material}"
msgstr "Bump against {material}"

#: app/audio/sintesis.py:552
#, python-brace-format
msgid "{como} Has chocado con una pared o un objeto de {material}; suena desde donde está."
msgstr "{como} You bumped into a wall or an object made of {material}; it sounds from where it is."

#: app/audio/sintesis.py:562
#, python-brace-format
msgid "Roce con {material}"
msgstr "Brushing against {material}"

#: app/audio/sintesis.py:563
#, python-brace-format
msgid "{como} Vas rozando una pared o un objeto de {material}, por el lado en que suena."
msgstr "{como} You are brushing against a wall or an object made of {material}, on the side it sounds from."

#: app/audio/sintesis.py:699
msgid "Puerta que se abre"
msgstr "Door opening"

#: app/audio/sintesis.py:700
msgid "Un clic de manilla y la bisagra que sube de tono: has abierto una puerta. Suena desde la puerta."
msgstr "A click of the handle and the hinge rising in pitch: you opened a door. It sounds from the door."

#: app/audio/sintesis.py:706
msgid "Puerta que se cierra"
msgstr "Door closing"

#: app/audio/sintesis.py:707
msgid "La bisagra baja de tono y la puerta da un golpe: una puerta se ha cerrado."
msgstr "The hinge drops in pitch and the door bangs: a door has closed."

#: app/audio/sintesis.py:714 app/motor/movimiento.py:522
msgid "Puerta cerrada con llave"
msgstr "Locked door"

#: app/audio/sintesis.py:715
msgid "La manilla traquetea dos veces y la puerta no cede: está cerrada con llave y no puedes pasar por ahí."
msgstr "The handle rattles twice and the door does not give way: it is locked and you cannot go through there."

#: app/audio/sintesis.py:721
msgid "Puerta automática"
msgstr "Automatic door"

#: app/audio/sintesis.py:722
msgid "Un deslizamiento con zumbido de motor: una puerta corredera automática se abre o se cierra."
msgstr "A slide with a motor hum: an automatic sliding door opens or closes."

#: app/audio/sintesis.py:729
msgid "Peldaño que sube"
msgstr "Step up"

#: app/audio/sintesis.py:730
msgid "Una pisada y dos notas que suben: has subido un peldaño. Cada peldaño suena un poco más agudo que el anterior."
msgstr "A footstep and two rising notes: you went up a step. Each step sounds a little higher than the one before."

#: app/audio/sintesis.py:736
msgid "Peldaño que baja"
msgstr "Step down"

#: app/audio/sintesis.py:737
msgid "Una pisada y dos notas que bajan: has bajado un peldaño. Cada peldaño suena un poco más grave que el anterior."
msgstr "A footstep and two falling notes: you went down a step. Each step sounds a little lower than the one before."

#: app/audio/sintesis.py:743 app/dominio/edicion.py:824 app/dominio/modelo.py:122 app/importar/osm_conversion.py:1561 app/motor/movimiento.py:817
msgid "Rampa"
msgstr "Ramp"

#: app/audio/sintesis.py:744
msgid "Un deslizamiento continuo, sin escalones: avanzas por una rampa. Más agudo si subes, más grave si bajas."
msgstr "A continuous slide, with no steps: you are moving along a ramp. Higher if you go up, lower if you go down."

#: app/audio/sintesis.py:751
msgid "Ascensor, botón de llamada"
msgstr "Elevator, call button"

#: app/audio/sintesis.py:752
msgid "Un clic y un pitido: has llamado al ascensor o has elegido planta."
msgstr "A click and a beep: you called the elevator or chose a level."

#: app/audio/sintesis.py:759
msgid "Ascensor, puerta"
msgstr "Elevator, door"

#: app/audio/sintesis.py:760
msgid "Un deslizamiento grave que acaba en un tope: la puerta del ascensor se abre o se cierra."
msgstr "A low slide that ends with a stop: the elevator door opens or closes."

#: app/audio/sintesis.py:767
msgid "Ascensor en marcha"
msgstr "Elevator moving"

#: app/audio/sintesis.py:768
msgid "Un zumbido continuo a tu alrededor mientras el ascensor se mueve entre plantas."
msgstr "A continuous hum around you while the elevator moves between levels."

#: app/audio/sintesis.py:777
msgid "Ascensor, llegada"
msgstr "Elevator, arrival"

#: app/audio/sintesis.py:778
msgid "Dos campanadas, la segunda más grave: el ascensor ha llegado a la planta."
msgstr "Two chimes, the second one lower: the elevator has arrived at the level."

#: app/audio/sintesis.py:786
#, python-brace-format
msgid "Ascensor, tono de la planta {planta}"
msgstr "Elevator, tone for level {planta}"

#: app/audio/sintesis.py:787
msgid "Una campanilla cuya nota dice la planta: cuanto más aguda, más arriba. La planta 0 es la más grave."
msgstr "A chime whose note tells the level: the higher the note, the higher the level. Level 0 is the lowest."

#: app/audio/sintesis.py:897 app/ui/seguimiento/editor_ayudas.py:233
msgid "Baliza"
msgstr "Beacon"

#: app/audio/sintesis.py:898
msgid "Un pulso suave que suena desde tu destino. Gírate hasta oírlo delante y camina hacia él."
msgstr "A soft pulse that sounds from your destination. Turn until you hear it in front of you and walk toward it."

#: app/audio/sintesis.py:904
msgid "Baliza, bien encaminado"
msgstr "Beacon, on course"

#: app/audio/sintesis.py:905
msgid "El mismo pulso, más agudo y brillante: estás mirando hacia el destino."
msgstr "The same pulse, higher and brighter: you are facing the destination."

#: app/audio/sintesis.py:911
msgid "Baliza, destino a tu espalda"
msgstr "Beacon, destination behind you"

#: app/audio/sintesis.py:912
msgid "Dos notas graves que bajan: el destino queda detrás de ti. Date la vuelta."
msgstr "Two low falling notes: the destination is behind you. Turn around."

#: app/audio/sintesis.py:918
msgid "Baliza, destino cerca"
msgstr "Beacon, destination nearby"

#: app/audio/sintesis.py:919
msgid "Dos pulsos rápidos y agudos: estás a pocos pasos del destino."
msgstr "Two quick, high pulses: you are a few steps from the destination."

#: app/audio/sintesis.py:925
msgid "Llegada"
msgstr "Arrival"

#: app/audio/sintesis.py:926
msgid "Cuatro notas que suben: has llegado al destino."
msgstr "Four rising notes: you have reached the destination."

#: app/audio/sintesis.py:932
msgid "Bastón sonoro, pared"
msgstr "Sound cane, wall"

#: app/audio/sintesis.py:932
msgid "Un tono lleno y corto: el bastón ha encontrado una pared. Más agudo cuanto más cerca."
msgstr "A full, short tone: the cane has found a wall. Higher the closer it is."

#: app/audio/sintesis.py:935
msgid "Bastón sonoro, puerta"
msgstr "Sound cane, door"

#: app/audio/sintesis.py:936
msgid "Dos toques de madera, el segundo más agudo: en esa dirección hay una puerta o un hueco para pasar."
msgstr "Two wooden taps, the second one higher: in that direction there is a door or a doorway to go through."

#: app/audio/sintesis.py:938
msgid "Bastón sonoro, objeto"
msgstr "Sound cane, object"

#: app/audio/sintesis.py:938
msgid "Una nota hueca, como un xilófono: hay un mueble o un objeto en esa dirección."
msgstr "A hollow note, like a xylophone: there is a piece of furniture or an object in that direction."

#: app/audio/sintesis.py:941
msgid "Bastón sonoro, paso libre"
msgstr "Sound cane, clear path"

#: app/audio/sintesis.py:942
msgid "Un soplo de aire, sin nota: no hay nada en esa dirección hasta donde alcanza el bastón."
msgstr "A puff of air, with no note: there is nothing in that direction as far as the cane reaches."

#: app/audio/sintesis.py:944
msgid "Bastón sonoro, escalón"
msgstr "Sound cane, step"

#: app/audio/sintesis.py:944
msgid "Tres toques rápidos que suben: hay una escalera o un escalón."
msgstr "Three quick rising taps: there are stairs or a step."

#: app/audio/sintesis.py:945
msgid "Bastón sonoro, bordillo"
msgstr "Sound cane, curb"

#: app/audio/sintesis.py:945
msgid "Un golpe grave y dos chasquidos: hay un bordillo, el borde de la acera."
msgstr "A low knock and two clicks: there is a curb, the edge of the sidewalk."

#: app/audio/sintesis.py:950
msgid "Distancia: cerca"
msgstr "Distance: near"

#: app/audio/sintesis.py:950
msgid "Tres pitidos agudos: lo que señalas está a menos de dos pasos."
msgstr "Three high beeps: what you are pointing at is less than two steps away."

#: app/audio/sintesis.py:951
msgid "Distancia: media"
msgstr "Distance: medium"

#: app/audio/sintesis.py:951
msgid "Dos pitidos medios: lo que señalas está a unos pocos metros."
msgstr "Two medium beeps: what you are pointing at is a few meters away."

#: app/audio/sintesis.py:952
msgid "Distancia: lejos"
msgstr "Distance: far"

#: app/audio/sintesis.py:952
msgid "Un pitido grave: lo que señalas está lejos."
msgstr "One low beep: what you are pointing at is far away."

#: app/audio/sintesis.py:957
msgid "Brújula, norte"
msgstr "Compass, north"

#: app/audio/sintesis.py:957
msgid "Una nota aguda y sola, que suena desde el norte."
msgstr "A single high note, sounding from the north."

#: app/audio/sintesis.py:958
msgid "Brújula, este"
msgstr "Compass, east"

#: app/audio/sintesis.py:958
msgid "Dos notas iguales, que suenan desde el este."
msgstr "Two equal notes, sounding from the east."

#: app/audio/sintesis.py:959
msgid "Brújula, sur"
msgstr "Compass, south"

#: app/audio/sintesis.py:959
msgid "Una nota grave y sola, que suena desde el sur."
msgstr "A single low note, sounding from the south."

#: app/audio/sintesis.py:960
msgid "Brújula, oeste"
msgstr "Compass, west"

#: app/audio/sintesis.py:960
msgid "Tres notas iguales, que suenan desde el oeste."
msgstr "Three equal notes, sounding from the west."

#: app/audio/sintesis.py:961
msgid "Brújula, noreste"
msgstr "Compass, northeast"

#: app/audio/sintesis.py:961
msgid "La nota del norte y luego la del este."
msgstr "The north note and then the east note."

#: app/audio/sintesis.py:962
msgid "Brújula, sureste"
msgstr "Compass, southeast"

#: app/audio/sintesis.py:962
msgid "La nota del sur y luego la del este."
msgstr "The south note and then the east note."

#: app/audio/sintesis.py:963
msgid "Brújula, suroeste"
msgstr "Compass, southwest"

#: app/audio/sintesis.py:963
msgid "La nota del sur y luego la del oeste."
msgstr "The south note and then the west note."

#: app/audio/sintesis.py:964
msgid "Brújula, noroeste"
msgstr "Compass, northwest"

#: app/audio/sintesis.py:964
msgid "La nota del norte y luego la del oeste."
msgstr "The north note and then the west note."

#: app/audio/sintesis.py:970
msgid "Chasquido para el eco"
msgstr "Click for echo"

#: app/audio/sintesis.py:971
msgid "Un chasquido de lengua. Escucha cómo responde el lugar: seco en una habitación pequeña, con cola en una sala grande o una escalera."
msgstr "A tongue click. Listen to how the place answers: dry in a small room, with a tail in a large hall or a stairwell."

#: app/audio/sintesis.py:1070
msgid "Premio que aparece"
msgstr "Reward appears"

#: app/audio/sintesis.py:1071
msgid "Cinco tintineos que suben: hay un premio por aquí. Suena desde donde está."
msgstr "Five rising chimes: there is a reward around here. It sounds from where it is."

#: app/audio/sintesis.py:1078
msgid "Premio cerca"
msgstr "Reward nearby"

#: app/audio/sintesis.py:1079
msgid "Un centelleo que se repite desde el premio. Acércate hasta tenerlo encima y recógelo."
msgstr "A sparkle that repeats from the reward. Get closer until you are right on it and collect it."

#: app/audio/sintesis.py:1087
msgid "Premio recogido"
msgstr "Reward collected"

#: app/audio/sintesis.py:1088
msgid "Unas monedas rápidas: has recogido un premio."
msgstr "Some quick coins: you collected a reward."

#: app/audio/sintesis.py:1095
msgid "Tesoro"
msgstr "Treasure"

#: app/audio/sintesis.py:1096
msgid "Una melodía que sube con una lluvia de tintineos: has encontrado un tesoro o el premio principal."
msgstr "A rising melody with a shower of chimes: you found a treasure or the main reward."

#: app/audio/sintesis.py:1103
msgid "Logro"
msgstr "Achievement"

#: app/audio/sintesis.py:1104
msgid "Tres notas que suben: has completado un objetivo."
msgstr "Three rising notes: you completed a goal."

#: app/audio/sintesis.py:1111
msgid "Una estrella"
msgstr "One star"

#: app/audio/sintesis.py:1111
msgid "Una campanilla: has conseguido una estrella."
msgstr "A chime: you earned a star."

#: app/audio/sintesis.py:1112
msgid "Dos estrellas"
msgstr "Two stars"

#: app/audio/sintesis.py:1112
msgid "Dos campanillas que suben: has conseguido dos estrellas."
msgstr "Two rising chimes: you earned two stars."

#: app/audio/sintesis.py:1113
msgid "Tres estrellas"
msgstr "Three stars"

#: app/audio/sintesis.py:1113
msgid "Tres campanillas que suben: has conseguido las tres estrellas."
msgstr "Three rising chimes: you earned all three stars."

#: app/audio/sintesis.py:1119 app/reproductor/pantallas/principal.py:217 app/ui/seguimiento/alumnos.py:383 app/ui/seguimiento/alumnos.py:418
msgid "Medalla"
msgstr "Medal"

#: app/audio/sintesis.py:1120
msgid "Una fanfarria de trompetas: has ganado una medalla."
msgstr "A trumpet fanfare: you won a medal."

#: app/audio/sintesis.py:1128
msgid "Eso no es"
msgstr "That's not it"

#: app/audio/sintesis.py:1129
msgid "Dos notas graves y suaves que bajan: no era eso, o por ahí no se puede. Prueba otra cosa."
msgstr "Two soft, low falling notes: that was not it, or you cannot go that way. Try something else."

#: app/audio/sintesis.py:1137 app/entrada/acciones.py:84 app/ui/seguimiento/textos.py:64
msgid "Pista"
msgstr "Hint"

#: app/audio/sintesis.py:1138
msgid "Dos campanillas que suben y se quedan en el aire: a continuación viene una pista."
msgstr "Two rising chimes that hang in the air: a hint comes next."

#: app/audio/sintesis.py:1154
msgid "Menú, moverse"
msgstr "Menu, move"

#: app/audio/sintesis.py:1155
msgid "Un toque muy corto: has pasado a otra opción."
msgstr "A very short tap: you moved to another option."

#: app/audio/sintesis.py:1161
msgid "Menú, elegir"
msgstr "Menu, select"

#: app/audio/sintesis.py:1162
msgid "Dos notas que suben: has elegido la opción."
msgstr "Two rising notes: you selected the option."

#: app/audio/sintesis.py:1168
msgid "Menú, atrás"
msgstr "Menu, back"

#: app/audio/sintesis.py:1169
msgid "Dos notas que bajan: has vuelto atrás o has cancelado."
msgstr "Two falling notes: you went back or canceled."

#: app/audio/sintesis.py:1175
msgid "Menú, borde"
msgstr "Menu, edge"

#: app/audio/sintesis.py:1176
msgid "Un toque grave: no hay más opciones en esa dirección."
msgstr "A low tap: there are no more options in that direction."

#: app/audio/sintesis.py:1182
msgid "Menú, abrir"
msgstr "Menu, open"

#: app/audio/sintesis.py:1183
msgid "Tres notas rápidas que suben: se abre un menú."
msgstr "Three quick rising notes: a menu opens."

#: app/audio/sintesis.py:1189
msgid "Menú, cerrar"
msgstr "Menu, close"

#: app/audio/sintesis.py:1190
msgid "Tres notas rápidas que bajan: se cierra el menú."
msgstr "Three quick falling notes: the menu closes."

#: app/audio/sintesis.py:1196
msgid "Menú, ajuste"
msgstr "Menu, setting"

#: app/audio/sintesis.py:1197
msgid "Un toque agudo y muy corto: has cambiado el valor de un ajuste."
msgstr "A very short, high tap: you changed the value of a setting."

#: app/audio/sintesis.py:1321
msgid "Semáforo en verde"
msgstr "Traffic light green"

#: app/audio/sintesis.py:1322
msgid "Píos seguidos desde el poste del semáforo: los coches están parados y puedes cruzar. Camina hacia el que suena enfrente."
msgstr "Continuous chirps from the traffic light pole: cars have stopped and you can cross. Walk toward the one sounding across the street."

#: app/audio/sintesis.py:1330
msgid "Semáforo intermitente"
msgstr "Traffic light flashing"

#: app/audio/sintesis.py:1331
msgid "Píos muy rápidos: el verde se acaba. Si no has empezado a cruzar, espera al siguiente."
msgstr "Very fast chirps: the green is ending. If you have not started crossing, wait for the next one."

#: app/audio/sintesis.py:1339
msgid "Semáforo en rojo"
msgstr "Traffic light red"

#: app/audio/sintesis.py:1340
msgid "Un toque lento desde el poste: está en rojo para ti. Sirve para encontrar el poste y esperar junto a él."
msgstr "A slow tick from the pole: it is red for you. It helps you find the pole and wait next to it."

#: app/audio/sintesis.py:1348
msgid "Pulsador del semáforo"
msgstr "Traffic light push button"

#: app/audio/sintesis.py:1349
msgid "Un clic y dos pitidos: has pulsado el botón para pedir el verde."
msgstr "A click and two beeps: you pressed the button to request the green."

#: app/audio/sintesis.py:1356
msgid "Coche que pasa"
msgstr "Car passing"

#: app/audio/sintesis.py:1357
msgid "Un motor que se acerca, pasa y se aleja con ruido de ruedas: un coche circula por la calzada."
msgstr "An engine that approaches, passes and moves away with the sound of tires: a car is driving along the roadway."

#: app/audio/sintesis.py:1364
msgid "Moto que pasa"
msgstr "Motorcycle passing"

#: app/audio/sintesis.py:1365
msgid "Un motor agudo y zumbón que pasa deprisa: una moto."
msgstr "A high, buzzing engine passing quickly: a motorcycle."

#: app/audio/sintesis.py:1372
msgid "Autobús que pasa"
msgstr "Bus passing"

#: app/audio/sintesis.py:1373
msgid "Un motor grave y largo, y al final el soplido de los frenos: un autobús."
msgstr "A long, low engine, and at the end the hiss of the brakes: a bus."

#: app/audio/sintesis.py:1379
msgid "Tráfico leve"
msgstr "Light traffic"

#: app/audio/sintesis.py:1379
msgid "Un rumor lejano con algún coche suelto: una calle tranquila."
msgstr "A distant rumble with the odd car: a quiet street."

#: app/audio/sintesis.py:1380
msgid "Tráfico medio"
msgstr "Moderate traffic"

#: app/audio/sintesis.py:1380
msgid "Rumor continuo y coches frecuentes: una calle con bastante circulación."
msgstr "A continuous rumble and frequent cars: a fairly busy street."

#: app/audio/sintesis.py:1381 app/dominio/modelo.py:156
msgid "Tráfico intenso"
msgstr "Heavy traffic"

#: app/audio/sintesis.py:1381
msgid "Rumor fuerte y coches sin parar: una avenida. Extrema el cuidado al cruzar."
msgstr "A loud rumble and nonstop cars: an avenue. Take extra care when crossing."

#: app/audio/sintesis.py:1396 app/exportar/fichas.py:97
msgid "Bordillo"
msgstr "Curb"

#: app/audio/sintesis.py:1397
msgid "Un raspado y un golpe grave a tus pies: has bajado de la acera a la calzada, o has subido a la acera."
msgstr "A scrape and a low knock at your feet: you stepped down from the sidewalk to the roadway, or up onto the sidewalk."

#: app/audio/sintesis.py:1521 app/dominio/ejemplos.py:147
msgid "Frigorífico"
msgstr "Refrigerator"

#: app/audio/sintesis.py:1522
msgid "Un zumbido grave y constante. Suele estar en la cocina y sirve de referencia fija."
msgstr "A low, steady hum. It is usually in the kitchen and serves as a fixed landmark."

#: app/audio/sintesis.py:1530 app/dominio/ejemplos.py:158
msgid "Reloj de pared"
msgstr "Wall clock"

#: app/audio/sintesis.py:1531
msgid "Tic, tac, un golpe por segundo. Marca siempre el mismo punto de la habitación."
msgstr "Tick, tock, one beat per second. It always marks the same spot in the room."

#: app/audio/sintesis.py:1539
msgid "Grifo abierto"
msgstr "Running faucet"

#: app/audio/sintesis.py:1540
msgid "Un chorro de agua fino contra el fregadero o el lavabo."
msgstr "A thin stream of water against the sink or washbasin."

#: app/audio/sintesis.py:1548
msgid "Ventilador"
msgstr "Fan"

#: app/audio/sintesis.py:1549
msgid "Un soplo continuo con el batir de las aspas."
