msgid "Nombre"
msgstr "Name"

#: app/actividades/tipos.py:290 app/ui/seguimiento/reserva_actividades.py:83
msgid "Nombre con el que el alumno y el profesional verán la actividad."
msgstr "Name the student and the instructor will see for this activity."

#: app/actividades/tipos.py:293 app/ui/complemento_propio.py:284 app/ui/dialogos_importar.py:251 app/ui/dialogos_insertar.py:298 app/ui/esquemas_elementos.py:126 app/ui/esquemas_elementos.py:135 app/ui/esquemas_elementos.py:521 app/ui/esquemas_elementos.py:550 app/ui/esquemas_elementos.py:596 app/ui/esquemas_elementos.py:645 app/ui/esquemas_elementos.py:904 app/ui/esquemas_elementos.py:938 app/ui/esquemas_elementos.py:1133 app/ui/esquemas_elementos.py:1159 app/ui/esquemas_elementos.py:1179 app/ui/seguimiento/reserva_actividades.py:85 app/ui/ventana_principal.py:509 app/ui/ventana_principal.py:522
msgid "Descripción"
msgstr "Description"

#: app/actividades/tipos.py:293 app/ui/seguimiento/reserva_actividades.py:85
msgid "Para qué sirve esta actividad; solo la lee el profesional."
msgstr "What this activity is for; only the instructor reads it."

#: app/actividades/tipos.py:296 app/ui/seguimiento/reserva_actividades.py:88
msgid "Estilo de presentación"
msgstr "Presentation style"

#: app/actividades/tipos.py:298
msgid "Cómo se le habla al alumno. El contenido de aprendizaje es el mismo en los tres estilos."
msgstr "How the student is spoken to. The learning content is the same in all three styles."

#: app/actividades/tipos.py:304 app/ui/esquemas_elementos.py:132 app/ui/seguimiento/reserva_actividades.py:101
msgid "Punto de inicio"
msgstr "Start point"

#: app/actividades/tipos.py:306 app/ui/seguimiento/reserva_actividades.py:103
msgid "Dónde empieza el alumno y hacia dónde mira. Vacío: el inicio del entorno."
msgstr "Where the student starts and which way they face. Empty: the environment's start point."

#: app/actividades/tipos.py:311 app/ui/seguimiento/reserva_actividades.py:233
msgid "Mensaje de inicio"
msgstr "Start message"

#: app/actividades/tipos.py:313
msgid "Se dice al empezar. Vacío: el mensaje de serie del estilo."
msgstr "Said at the start. Empty: the style's default message."

#: app/actividades/tipos.py:319
msgid "Mensaje de logro"
msgstr "Achievement message"

#: app/actividades/tipos.py:321
msgid "Se dice al conseguir cada objetivo. Vacío: el de serie."
msgstr "Said when each goal is reached. Empty: the default one."

#: app/actividades/tipos.py:326 app/ui/seguimiento/reserva_actividades.py:234
msgid "Mensaje final"
msgstr "Final message"

#: app/actividades/tipos.py:326
msgid "Se dice al terminar. Vacío: el de serie."
msgstr "Said at the end. Empty: the default one."

#: app/actividades/tipos.py:330 app/ui/seguimiento/editor_ayudas.py:41 app/ui/seguimiento/editor_ayudas.py:157 app/ui/seguimiento/reserva_actividades.py:231
msgid "Ayudas permitidas"
msgstr "Allowed help"

#: app/actividades/tipos.py:332
msgid "Qué ayudas puede usar el alumno y cuántas veces. Lo que no se indique queda como en la ficha del alumno."
msgstr "Which help the student can use and how many times. Anything not specified stays as in the student record."

#: app/actividades/tipos.py:338
msgid "Preguntar al terminar"
msgstr "Ask at the end"

#: app/actividades/tipos.py:340
msgid "Al acabar, tres preguntas breves y opcionales sobre esfuerzo, confianza y disfrute."
msgstr "At the end, three short optional questions about effort, confidence and enjoyment."

#: app/actividades/tipos.py:351 app/ui/seguimiento/reserva_actividades.py:199
msgid "Contrarreloj (segundos)"
msgstr "Time trial (seconds)"

#: app/actividades/tipos.py:353
msgid "Tiempo máximo de juego, sin contar las pausas. Cero: sin límite. Las prisas son siempre opcionales."
msgstr "Maximum play time, not counting pauses. Zero: no limit. Time pressure is always optional."

#: app/actividades/tipos.py:360
msgid "Baliza sonora hacia el objetivo"
msgstr "Sound beacon toward the goal"

#: app/actividades/tipos.py:362
msgid "«Siempre» guía en todo momento; «al pedirla» solo suena un rato cuando el alumno pide una pista. Si hay niveles, mandan ellos."
msgstr "“Always” guides at all times; “On request” only sounds for a while when the student asks for a hint. If there are levels, they take priority."

#: app/actividades/tipos.py:365 app/ui/seguimiento/presentador_actividades.py:31
msgid "Nunca"
msgstr "Never"

#: app/actividades/tipos.py:365 app/ui/seguimiento/presentador_actividades.py:31
msgid "Al pedir una pista"
msgstr "On request"

#: app/actividades/tipos.py:365 app/ui/seguimiento/presentador_actividades.py:31
msgid "Siempre"
msgstr "Always"

#: app/actividades/tipos.py:371 app/ui/seguimiento/reserva_actividades.py:210
msgid "Retirar las ayudas por niveles"
msgstr "Fade help by levels"

#: app/actividades/tipos.py:373
msgid "Cuatro niveles: con baliza, baliza solo al pedirla, sin baliza y sin «dónde estoy». Se sube al superar el anterior sin ayuda."
msgstr "Four levels: with beacon, beacon only on request, no beacon, and no beacon and no “where am I”. The student moves up after passing the previous level without help."

#: app/actividades/tipos.py:381 app/ui/seguimiento/reserva_actividades.py:220
msgid "Nivel de partida"
msgstr "Starting level"

#: app/actividades/tipos.py:383
msgid "Nivel en el que empieza el alumno (0 es el más fácil)."
msgstr "Level the student starts at (0 is the easiest)."

#: app/actividades/tipos.py:392
msgid "Fallos seguidos antes de ofrecer ayuda"
msgstr "Failures in a row before offering help"

#: app/actividades/tipos.py:394
msgid "Tras tantos tropiezos seguidos el juego ofrece una pista en lugar de insistir. Cero: no ofrecerla nunca."
msgstr "After this many stumbles in a row, the game offers a hint instead of insisting. Zero: never offer it."

#: app/actividades/tipos.py:402
msgid "Con personaje acompañante"
msgstr "With a companion character"

#: app/actividades/tipos.py:404
msgid "Solo en el estilo infantil: un personaje que se presenta al empezar y anima durante el juego."
msgstr "Only in the children's style: a character who introduces themselves at the start and gives encouragement during the game."

#: app/actividades/tipos.py:410
msgid "Nombre del acompañante"
msgstr "Companion's name"

#: app/actividades/tipos.py:412
msgid "Cómo se llama el personaje. Vacío: el de serie."
msgstr "What the character is called. Empty: the default one."

#: app/actividades/tipos.py:419
msgid "Recompensa que se desbloquea"
msgstr "Unlockable reward"

#: app/actividades/tipos.py:421
msgid "Algo que el alumno gana al juntar estrellas, por ejemplo «la casa del árbol». Vacío: ninguna."
msgstr "Something the student earns by collecting stars, for example “the tree house”. Empty: none."

#: app/actividades/tipos.py:427
msgid "Estrellas necesarias para desbloquearla"
msgstr "Stars needed to unlock it"

#: app/actividades/tipos.py:429
msgid "Cuántas estrellas, sumando las de sesiones anteriores, hacen falta."
msgstr "How many stars are needed, including those from previous sessions."

#: app/actividades/tipos.py:444
msgid "Cada premio tiene nombre, lugar, sonido, visibilidad (lejos, cerca u oculto), objeto que lo esconde y mensaje."
msgstr "Each reward has a name, place, sound, visibility (far, near or hidden), an object that hides it, and a message."

#: app/actividades/tipos.py:446
msgid "Premios de regalo por el camino; no hacen falta para terminar."
msgstr "Bonus rewards along the way; they are not needed to finish."

#: app/actividades/tipos.py:447 app/ui/seguimiento/editor_premios.py:477 app/ui/seguimiento/editor_premios.py:575 app/ui/seguimiento/editor_premios.py:609 app/ui/seguimiento/presentador_actividades.py:22 app/ui/seguimiento/reserva_actividades.py:111
msgid "Premios"
msgstr "Rewards"

#: app/actividades/tipos.py:454
msgid "Con el travieso"
msgstr "With the prankster"

#: app/actividades/tipos.py:456
msgid "Un personaje que de vez en cuando cambia de sitio un premio sin recoger, para obligar a volver a recorrer."
msgstr "A character who every now and then moves an uncollected reward, so the student has to search again."

#: app/actividades/tipos.py:462
msgid "Segundos entre travesuras"
msgstr "Seconds between pranks"

#: app/actividades/tipos.py:464
msgid "Cada cuánto tiempo de juego mueve un premio."
msgstr "How much play time passes between moving one reward and the next."

#: app/actividades/tipos.py:473
msgid "Travesuras como mucho"
msgstr "Maximum pranks"

#: app/actividades/tipos.py:475
msgid "Cuántas veces puede mover premios en una partida."
msgstr "How many times it can move rewards in one game."

#: app/actividades/tipos.py:489 app/ui/seguimiento/reserva_actividades.py:174
msgid "Número de pruebas"
msgstr "Number of trials"

#: app/actividades/tipos.py:491
msgid "Cuántas pruebas se generan si no se definen a mano."
msgstr "How many trials are generated if they are not defined by hand."

#: app/actividades/tipos.py:499
msgid "Pruebas definidas a mano"
msgstr "Trials defined by hand"

#: app/actividades/tipos.py:501
msgid "Vacío: el programa las genera con la semilla, siempre las mismas para la misma semilla."
msgstr "Empty: the program generates them from the seed, always the same ones for the same seed."

#: app/actividades/tipos.py:507
msgid "Semilla"
msgstr "Seed"

#: app/actividades/tipos.py:509
msgid "Número que fija las pruebas generadas: con la misma semilla el examen se repite idéntico otro día."
msgstr "Number that fixes the generated trials: with the same seed, the test is repeated identically on another day."

#: app/actividades/tipos.py:517
msgid "Regla de parada"
msgstr "Stopping rule"

#: app/actividades/tipos.py:519
msgid "Termina el examen antes de tiempo si el alumno falla demasiado al principio, para evitar la frustración."
msgstr "Ends the test early if the student fails too much at the beginning, to avoid frustration."

#: app/actividades/tipos.py:525
msgid "Se miran las primeras"
msgstr "First trials checked"

#: app/actividades/tipos.py:527
msgid "Número de pruebas iniciales que se tienen en cuenta."
msgstr "Number of initial trials taken into account."

#: app/actividades/tipos.py:536
msgid "Aciertos mínimos para seguir"
msgstr "Minimum correct answers to continue"

#: app/actividades/tipos.py:538
msgid "Si en esas primeras pruebas ya no se puede llegar a este número de aciertos, el examen termina."
msgstr "If in those first trials this number of correct answers can no longer be reached, the test ends."

#: app/actividades/tipos.py:547
msgid "Decir el resultado al final"
msgstr "Say the result at the end"

#: app/actividades/tipos.py:549
msgid "Durante el examen nunca se dice si se acierta. Con esto activado, al terminar se dice el total."
msgstr "During the test, the student is never told whether an answer is correct. With this turned on, the total is said at the end."

#: app/actividades/tipos.py:559
msgid "Límite de tiempo por prueba (segundos)"
msgstr "Time limit per trial (seconds)"

#: app/actividades/tipos.py:561
msgid "Tiempo de juego para cada prueba; el tiempo en pausa no cuenta. Cero: sin límite."
msgstr "Play time for each trial; time spent paused does not count. Zero: no limit."

#: app/actividades/tipos.py:578 app/actividades/tipos.py:738 app/ui/seguimiento/reserva_actividades.py:122 app/ui/seguimiento/reserva_actividades.py:163
msgid "En orden"
msgstr "In order"

#: app/actividades/tipos.py:580 app/ui/seguimiento/reserva_actividades.py:124
msgid "Los premios hay que encontrarlos en el orden de la lista."
msgstr "The rewards must be found in the order of the list."

#: app/actividades/tipos.py:586
msgid "Decir cuántos hay"
msgstr "Say how many there are"

#: app/actividades/tipos.py:588
msgid "Al empezar se dice cuántos premios hay escondidos."
msgstr "At the start, the student is told how many rewards are hidden."

#: app/actividades/tipos.py:599
msgid "Redactar las pistas que falten"
msgstr "Write the missing hints"

#: app/actividades/tipos.py:601
msgid "Si un premio no trae pista escrita, se redacta con las relaciones reales del entorno («al norte de la cocina»)."
msgstr "If a reward has no written hint, one is written from the real relationships in the environment (“north of the kitchen”)."

#: app/actividades/tipos.py:611 app/actividades/tipos.py:930 app/ui/seguimiento/reserva_actividades.py:186
msgid "Empate entre salidas (metros)"
msgstr "Tie between exits (meters)"

#: app/actividades/tipos.py:613 app/actividades/tipos.py:932
msgid "Dos salidas cuya distancia difiere menos que esto cuentan como igual de cercanas."
msgstr "Two exits whose distances differ by less than this count as equally close."

#: app/actividades/tipos.py:625
msgid "Encargos"
msgstr "Errands"

#: app/actividades/tipos.py:627
msgid "Pares «recoger» y «entregar», en orden: qué se coge, dónde y adónde se lleva."
msgstr "“Pick up” and “deliver” pairs, in order: what is picked up, where, and where it is taken."

#: app/actividades/tipos.py:635
msgid "Quién se esconde"
msgstr "Who hides"

#: app/actividades/tipos.py:635
msgid "Nombre del personaje escondido."
msgstr "Name of the hidden character."

#: app/actividades/tipos.py:638
msgid "Sonido que hace"
msgstr "Sound it makes"

#: app/actividades/tipos.py:640
msgid "Sonido con el que se delata de vez en cuando."
msgstr "Sound that gives it away every now and then."

#: app/actividades/tipos.py:646
msgid "Segundos entre ruidos"
msgstr "Seconds between noises"

#: app/actividades/tipos.py:648
msgid "Cada cuánto hace ruido."
msgstr "How often it makes a noise."

#: app/actividades/tipos.py:654
msgid "Rondas"
msgstr "Rounds"

#: app/actividades/tipos.py:654
msgid "Cuántas veces se esconde."
msgstr "How many times it hides."

#: app/actividades/tipos.py:657
msgid "Escondites"
msgstr "Hiding places"

#: app/actividades/tipos.py:659
msgid "Lugares donde puede esconderse. Vacío: los elige el programa, lejos del alumno."
msgstr "Places where it can hide. Empty: the program chooses them, far from the student."

#: app/actividades/tipos.py:667
msgid "Adónde lleva el guía"
msgstr "Where the guide leads"

#: app/actividades/tipos.py:667
msgid "Lugar al que conduce."
msgstr "Place the guide leads to."

#: app/actividades/tipos.py:669
msgid "Nombre del guía"
msgstr "Guide's name"

#: app/actividades/tipos.py:669
msgid "Cómo se llama el guía."
msgstr "What the guide is called."

#: app/actividades/tipos.py:672
msgid "Velocidad del guía (m/s)"
msgstr "Guide's speed (m/s)"

#: app/actividades/tipos.py:674
msgid "A qué paso anda; se para a esperar si el alumno se queda atrás."
msgstr "How fast the guide walks; it stops to wait if the student falls behind."

#: app/actividades/tipos.py:682
msgid "Distancia a la que espera (metros)"
msgstr "Waiting distance (meters)"

#: app/actividades/tipos.py:684
msgid "Si el alumno queda más lejos, el guía se para y le llama."
msgstr "If the student is farther away than this, the guide stops and calls them."

#: app/actividades/tipos.py:695
msgid "Parte que hay que descubrir"
msgstr "Portion to discover"

#: app/actividades/tipos.py:697
msgid "De 0,5 (la mitad de los espacios) a 1 (todos)."
msgstr "From 0.5 (half of the spaces) to 1 (all of them)."

#: app/actividades/tipos.py:709
msgid "Cruces que hay que hacer"
msgstr "Crossings to make"

#: app/actividades/tipos.py:711
msgid "Número de veces que hay que cruzar una calzada."
msgstr "Number of times a roadway must be crossed."

#: app/actividades/tipos.py:719
msgid "Lugar al que llegar"
msgstr "Place to reach"

#: app/actividades/tipos.py:721
msgid "Opcional: si se indica, además hay que llegar a ese lugar del otro lado."
msgstr "Optional: if set, the student must also reach that place on the other side."

#: app/actividades/tipos.py:730
msgid "Zonas de la visita"
msgstr "Tour zones"

#: app/actividades/tipos.py:732
msgid "Cada zona es un lugar y el texto que se dice al llegar. Vacío: todos los espacios, con su descripción."
msgstr "Each zone is a place and the text said on arrival. Empty: all the spaces, with their descriptions."

#: app/actividades/tipos.py:740
msgid "Las zonas se visitan en el orden de la lista."
msgstr "The zones are visited in the order of the list."

#: app/actividades/tipos.py:746
msgid "Narrada en vivo por el profesional"
msgstr "Narrated live by the instructor"

#: app/actividades/tipos.py:748
msgid "No se leen textos preparados: el profesional narra desde la supervisión con sus mensajes."
msgstr "No prepared texts are read: the instructor narrates from supervision with their messages."

#: app/actividades/tipos.py:755 app/actividades/tipos.py:801 app/ui/seguimiento/reserva_actividades.py:143
msgid "Destino"
msgstr "Destination"

#: app/actividades/tipos.py:755 app/actividades/tipos.py:801 app/ui/seguimiento/reserva_actividades.py:145
msgid "Lugar al que hay que llegar."
msgstr "Place to reach."

#: app/actividades/tipos.py:758 app/ui/seguimiento/reserva_actividades.py:153
msgid "Paradas intermedias"
msgstr "Intermediate stops"

#: app/actividades/tipos.py:760
msgid "Lugares por los que hay que pasar antes, en orden. Opcional."
msgstr "Places to pass through first, in order. Optional."

#: app/actividades/tipos.py:769
msgid "Lugar de ida"
msgstr "Outbound place"

#: app/actividades/tipos.py:769
msgid "Adónde se va antes de volver."
msgstr "Where to go before coming back."

#: app/actividades/tipos.py:773 app/actividades/tipos.py:792
msgid "Ida con baliza"
msgstr "Outbound trip with beacon"

#: app/actividades/tipos.py:775
msgid "La ida se hace siguiendo una baliza; la vuelta, que es lo que se mide, sin ella."
msgstr "The outbound trip follows a beacon; the return trip, which is what is measured, is made without it."

#: app/actividades/tipos.py:784
msgid "Lugares por los que pasar"
msgstr "Places to pass through"

#: app/actividades/tipos.py:786
msgid "Se visitan en orden y después se vuelve al punto de partida."
msgstr "They are visited in order and then the student returns to the starting point."

#: app/actividades/tipos.py:794
msgid "La ida se hace siguiendo una baliza; la vuelta, sin ella."
msgstr "The outbound trip follows a beacon; the return trip is made without it."

#: app/actividades/tipos.py:804
msgid "Paso cortado"
msgstr "Blocked passage"

#: app/actividades/tipos.py:806
msgid "Puerta, hueco, escalera o ascensor por el que hoy no se puede pasar."
msgstr "Door, doorway, stairs or elevator that cannot be used today."

#: app/actividades/tipos.py:815
msgid "Espacio que hay que encontrar"
msgstr "Space to find"

#: app/actividades/tipos.py:817
msgid "Solo se le dice el nombre al alumno."
msgstr "The student is only told its name."

#: app/actividades/tipos.py:823
msgid "Confirmar la llegada"
msgstr "Confirm arrival"

#: app/actividades/tipos.py:825
msgid "El alumno tiene que confirmar que cree haber llegado (con la orden de usar); si no, se detecta solo."
msgstr "The student must confirm they think they have arrived (with the use command); otherwise, arrival is detected automatically."

#: app/actividades/tipos.py:832 app/importar/osm_interiores.py:160
msgid "Sala"
msgstr "Room"

#: app/actividades/tipos.py:832
msgid "Sala que se va a conocer."
msgstr "Room to get to know."

#: app/actividades/tipos.py:835
msgid "Distancia a la pared (metros)"
msgstr "Distance from the wall (meters)"

#: app/actividades/tipos.py:837
msgid "Hasta dónde se considera que se va siguiendo la pared."
msgstr "How far away still counts as following the wall."

#: app/actividades/tipos.py:845
msgid "Parte del perímetro"
msgstr "Portion of the perimeter"

#: app/actividades/tipos.py:847
msgid "Parte del contorno que hay que recorrer antes de pasar al interior."
msgstr "Portion of the outline to walk before moving to the interior."

#: app/actividades/tipos.py:855
msgid "Parte del interior"
msgstr "Portion of the interior"

#: app/actividades/tipos.py:857
msgid "Parte del interior que hay que pisar para dar la sala por conocida."
msgstr "Portion of the interior to step on for the room to count as known."

#: app/actividades/tipos.py:868 app/entrada/teclado.py:40 app/seguimiento/informes.py:252 app/seguimiento/informes.py:264 app/seguimiento/informes.py:315 app/ui/dialogo_catalogo.py:1325 app/ui/dialogos_herramientas.py:453 app/ui/esquemas_elementos.py:476
msgid "Espacio"
msgstr "Space"

#: app/actividades/tipos.py:870
msgid "Habitación o acera cuya pared o bordillo se sigue."
msgstr "Room or sidewalk whose wall or curb is followed."

#: app/actividades/tipos.py:876
msgid "Lado"
msgstr "Side"

#: app/actividades/tipos.py:878
msgid "Qué lado del espacio hace de línea guía."
msgstr "Which side of the space acts as the shoreline."

#: app/actividades/tipos.py:880
msgid "El más largo"
msgstr "The longest"

#: app/actividades/tipos.py:881 app/ui/dialogo_catalogo.py:62 app/ui/esquemas_elementos.py:60 app/ui/esquemas_elementos.py:67
msgid "Norte"
msgstr "North"

#: app/actividades/tipos.py:882 app/ui/dialogo_catalogo.py:62 app/ui/esquemas_elementos.py:60 app/ui/esquemas_elementos.py:69
msgid "Este"
msgstr "East"

#: app/actividades/tipos.py:883 app/ui/dialogo_catalogo.py:62 app/ui/esquemas_elementos.py:60 app/ui/esquemas_elementos.py:71
msgid "Sur"
msgstr "South"

#: app/actividades/tipos.py:884 app/ui/dialogo_catalogo.py:62 app/ui/esquemas_elementos.py:60 app/ui/esquemas_elementos.py:73
msgid "Oeste"
msgstr "West"

#: app/actividades/tipos.py:891
msgid "Separación máxima (metros)"
msgstr "Maximum distance (meters)"

#: app/actividades/tipos.py:893
msgid "Más lejos que esto cuenta como haberse separado de la línea."
