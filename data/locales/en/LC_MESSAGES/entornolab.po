msgstr "{guia} is leading you. Follow the sound of the footsteps."

#: app/actividades/textos.py:161
msgid "Sigue al guía por el sonido de sus pasos."
msgstr "Follow the guide by the sound of the footsteps."

#: app/actividades/textos.py:163
msgid "Sigue los pasos del guía sin alejarte."
msgstr "Follow the guide's footsteps without falling behind."

#: app/actividades/textos.py:164
msgid "¡Por aquí! Te espero."
msgstr "This way! I'm waiting for you."

#: app/actividades/textos.py:164 app/actividades/textos.py:164
msgid "Por aquí."
msgstr "This way."

#: app/actividades/textos.py:166
msgid "¡Te has alejado! Ven hacia mis pasos."
msgstr "You've wandered off! Come toward my footsteps."

#: app/actividades/textos.py:167
msgid "Te has alejado. Vuelve hacia los pasos."
msgstr "You've moved away. Go back toward the footsteps."

#: app/actividades/textos.py:168
msgid "Te has alejado del guía."
msgstr "You have moved away from the guide."

#: app/actividades/textos.py:170
#, python-brace-format
msgid "Ahora, {conector}. Te espero al otro lado."
msgstr "Now, {conector}. I'll wait for you on the other side."

#: app/actividades/textos.py:171
#, python-brace-format
msgid "¡Hemos llegado a {lugar}!"
msgstr "We've made it to {lugar}!"

#: app/actividades/textos.py:171
#, python-brace-format
msgid "Destino alcanzado: {lugar}."
msgstr "Destination reached: {lugar}."

#: app/actividades/textos.py:171
#, python-brace-format
msgid "Hemos llegado a {lugar}."
msgstr "We have arrived at {lugar}."

#: app/actividades/textos.py:174
msgid "¡Eres un explorador! Descubre todos los sitios."
msgstr "You're an explorer! Discover every place."

#: app/actividades/textos.py:175
msgid "Misión: descubrir todo el mapa."
msgstr "Mission: discover the whole map."

#: app/actividades/textos.py:176
msgid "Recorre todos los espacios del lugar."
msgstr "Go through every space in the place."

#: app/actividades/textos.py:178
#, python-brace-format
msgid "{n} de {total}."
msgstr "{n} of {total}."

#: app/actividades/textos.py:181
msgid "Vamos a cruzar la calle con mucho cuidado. Escucha bien antes de cruzar."
msgstr "We're going to cross the street very carefully. Listen closely before you cross."

#: app/actividades/textos.py:182
msgid "Reto: cruzar por los pasos de peatones y con el semáforo a favor."
msgstr "Challenge: cross at the crosswalks and with the light in your favor."

#: app/actividades/textos.py:183
msgid "Práctica de cruces: decide cuándo cruzar. Es un simulador: no dice si un cruce real es seguro."
msgstr "Crossing practice: decide when to cross. This is a simulator: it does not tell you whether a real crossing is safe."

#: app/actividades/textos.py:185
msgid "¡Muy bien cruzado!"
msgstr "Great crossing!"

#: app/actividades/textos.py:185
msgid "Cruce perfecto."
msgstr "Perfect crossing."

#: app/actividades/textos.py:185
msgid "Cruce correcto: por el paso y sin tráfico."
msgstr "Correct crossing: at the crosswalk and with no traffic."

#: app/actividades/textos.py:186
msgid "Has cruzado sin peligro, pero fuera del paso de peatones."
msgstr "You crossed safely, but outside the crosswalk."

#: app/actividades/textos.py:187
msgid "Has cruzado con el semáforo en rojo. Espera al verde la próxima vez."
msgstr "You crossed on a red light. Wait for green next time."

#: app/actividades/textos.py:189
msgid "¡Cuidado! Venía un coche. Espera a que no se oiga ninguno."
msgstr "Careful! A car was coming. Wait until you can't hear any."

#: app/actividades/textos.py:190
msgid "Cruce con peligro: venía un vehículo."
msgstr "Dangerous crossing: a vehicle was coming."

#: app/actividades/textos.py:191
msgid "Cruce inseguro: había un vehículo cerca."
msgstr "Unsafe crossing: there was a vehicle nearby."

#: app/actividades/textos.py:193
#, python-brace-format
msgid "Después, ve a {lugar}."
msgstr "Then, go to {lugar}."

#: app/actividades/textos.py:195
msgid "¡A explorar!"
msgstr "Let's explore!"

#: app/actividades/textos.py:195
msgid "Exploración libre."
msgstr "Free exploration."

#: app/actividades/textos.py:195
msgid "Exploración libre: recorre el lugar a tu ritmo."
msgstr "Free exploration: move around the place at your own pace."

#: app/actividades/textos.py:197
msgid "Vamos a conocer esta sala. Primero, da la vuelta siguiendo la pared."
msgstr "Let's get to know this room. First, go all the way around trailing the wall."

#: app/actividades/textos.py:198
msgid "Vas a conocer la sala: primero el perímetro, después el interior."
msgstr "You are going to get to know the room: first the perimeter, then the interior."

#: app/actividades/textos.py:199
msgid "Familiarización de sala: primero el perímetro, después el interior."
msgstr "Room familiarization: first the perimeter, then the interior."

#: app/actividades/textos.py:201
#, python-brace-format
msgid "Recorre el perímetro de {sala} siguiendo la pared."
msgstr "Go around the perimeter of {sala} trailing the wall."

#: app/actividades/textos.py:202
#, python-brace-format
msgid "Ahora recorre el interior de {sala}, cruzándola de lado a lado."
msgstr "Now explore the interior of {sala}, crossing it from side to side."

#: app/actividades/textos.py:203
#, python-brace-format
msgid "Llevas {porcentaje} por ciento del perímetro."
msgstr "You have covered {porcentaje} percent of the perimeter."

#: app/actividades/textos.py:205
msgid "¡Ya conoces las paredes! Ahora cruza por el medio."
msgstr "Now you know the walls! Now cross through the middle."

#: app/actividades/textos.py:206
msgid "Perímetro hecho. Ahora, el interior."
msgstr "Perimeter done. Now, the interior."

#: app/actividades/textos.py:207
msgid "Perímetro completado. Ahora recorre el interior."
msgstr "Perimeter completed. Now explore the interior."

#: app/actividades/textos.py:209
msgid "Has salido de la sala. Vuelve a entrar."
msgstr "You have left the room. Go back in."

#: app/actividades/textos.py:211
msgid "Vamos a seguir la pared sin soltarnos."
msgstr "Let's follow the wall without letting go."

#: app/actividades/textos.py:212
msgid "Reto: seguir la línea guía sin separarte."
msgstr "Challenge: follow the shoreline without moving away from it."

#: app/actividades/textos.py:213
msgid "Sigue la línea guía de un extremo a otro sin separarte."
msgstr "Follow the shoreline from one end to the other without moving away from it."

#: app/actividades/textos.py:215
#, python-brace-format
msgid "Sigue {linea} hasta el final."
msgstr "Follow {linea} to the end."

#: app/actividades/textos.py:216
#, python-brace-format
msgid "la pared {lado} de {espacio}"
msgstr "the {lado} wall of {espacio}"

#: app/actividades/textos.py:217
#, python-brace-format
msgid "el borde {lado} de {espacio}"
msgstr "the {lado} edge of {espacio}"

#: app/actividades/textos.py:219
msgid "¡Te has soltado! Vuelve a la pared."
msgstr "You let go! Go back to the wall."

#: app/actividades/textos.py:220
msgid "Te has separado. Vuelve a la línea."
msgstr "You moved away. Go back to the line."

#: app/actividades/textos.py:221
msgid "Te has separado de la línea guía."
msgstr "You have moved away from the shoreline."

#: app/actividades/textos.py:223
msgid "Vas por la mitad."
msgstr "You're halfway there."

#: app/actividades/textos.py:226
msgid "Vamos a hacer unas pruebas. No hay pistas y no te diré si aciertas. Hazlo sin prisa."
msgstr "Let's do some trials. There are no hints, and I won't tell you if you're right. Take your time."

#: app/actividades/textos.py:227 app/actividades/textos.py:228
msgid "Empieza el examen. No hay pistas y no se dice si aciertas. Hazlo a tu ritmo."
msgstr "The test begins. There are no hints, and you won't be told if you're right. Go at your own pace."

#: app/actividades/textos.py:230
msgid "El examen ha terminado. Gracias."
msgstr "The test is over. Thank you."

#: app/actividades/textos.py:231
#, python-brace-format
msgid "Prueba {n} de {total}."
msgstr "Trial {n} of {total}."

#: app/actividades/textos.py:232
#, python-brace-format
msgid "Estás en {lugar}."
msgstr "You are in {lugar}."

#: app/actividades/textos.py:233
#, python-brace-format
msgid "Ve a {destino}. Cuando creas que has llegado, confírmalo con la orden de usar."
msgstr "Go to {destino}. When you think you have arrived, confirm it with the use command."

#: app/actividades/textos.py:235
msgid "Anotado."
msgstr "Noted."

#: app/actividades/textos.py:236
msgid "Se acabó el tiempo de esta prueba."
msgstr "Time is up for this trial."

#: app/actividades/textos.py:237
msgid "Lo dejamos aquí por hoy."
msgstr "Let's stop here for today."

#: app/actividades/textos.py:238
msgid "Sal del edificio por la salida más cercana."
msgstr "Leave the building through the nearest exit."

#: app/actividades/textos.py:239
#, python-brace-format
msgid "Sin moverte del sitio, gírate hacia {destino} y confírmalo con la orden de usar."
msgstr "Without moving from where you are, turn toward {destino} and confirm it with the use command."

#: app/actividades/textos.py:240
#, python-brace-format
msgid "Andando desde aquí, ¿qué queda más cerca: {a} o {b}?"
msgstr "Walking from here, which is closer: {a} or {b}?"

#: app/actividades/textos.py:241
#, python-brace-format
msgid "En línea recta desde aquí, ¿qué queda más cerca: {a} o {b}?"
msgstr "In a straight line from here, which is closer: {a} or {b}?"

#: app/actividades/textos.py:242
#, python-brace-format
msgid "¿Qué hay al {lado} de {referencia}?"
msgstr "What is to the {lado} of {referencia}?"

#: app/actividades/textos.py:243
#, python-brace-format
msgid "Opción {n} de {total}: {texto}."
msgstr "Option {n} of {total}: {texto}."

#: app/actividades/textos.py:244
msgid "Cambia de opción con la orden de objetivo y confirma con la orden de usar."
msgstr "Change options with the goal command and confirm with the use command."

#: app/actividades/textos.py:245
#, python-brace-format
msgid "Primero sigue la baliza hasta {destino}."
msgstr "First, follow the beacon to {destino}."

#: app/actividades/textos.py:246
#, python-brace-format
msgid "Ahora sigue la baliza hasta {destino}."
msgstr "Now follow the beacon to {destino}."

#: app/actividades/textos.py:247
#, python-brace-format
msgid "Ahora vuelve a {destino} sin ayuda. Cuando creas que has llegado, confírmalo con la orden de usar."
msgstr "Now go back to {destino} without help. When you think you have arrived, confirm it with the use command."

#: app/actividades/textos.py:248
#, python-brace-format
msgid "Ahora ve a {destino} por el camino más corto que sepas. Cuando creas que has llegado, confírmalo con la orden de usar."
msgstr "Now go to {destino} by the shortest way you know. When you think you have arrived, confirm it with the use command."

#: app/actividades/textos.py:253 app/dominio/geometria.py:32 app/seguimiento/informes.py:76 app/ui/seguimiento/textos.py:99
msgid "norte"
msgstr "north"

#: app/actividades/textos.py:253 app/dominio/geometria.py:34 app/seguimiento/informes.py:76 app/ui/seguimiento/textos.py:99
msgid "este"
msgstr "east"

#: app/actividades/textos.py:253 app/dominio/geometria.py:36 app/seguimiento/informes.py:76 app/ui/seguimiento/textos.py:99
msgid "sur"
msgstr "south"

#: app/actividades/textos.py:253 app/dominio/geometria.py:38 app/seguimiento/informes.py:76 app/ui/seguimiento/textos.py:99
msgid "oeste"
msgstr "west"

#: app/actividades/textos.py:290 app/importar/comun.py:94 app/reproductor/textos.py:124
#, python-brace-format
msgid "{n} minuto"
msgid_plural "{n} minutos"
msgstr[0] "{n} minute"
msgstr[1] "{n} minutes"

#: app/actividades/textos.py:292 app/importar/comun.py:93 app/importar/comun.py:97 app/reproductor/carga.py:236 app/reproductor/textos.py:121
#, python-brace-format
msgid "{n} segundo"
msgid_plural "{n} segundos"
msgstr[0] "{n} second"
msgstr[1] "{n} seconds"

#: app/actividades/textos.py:293
#, python-brace-format
msgid "{a} y {b}"
msgstr "{a} and {b}"

#. Traductores: el final de una lista: «la mesa, la silla y la puerta».
#: app/actividades/textos.py:301 app/motor/lenguaje.py:95
#, python-brace-format
msgid "{lista} y {ultimo}"
msgstr "{lista} and {ultimo}"

#: app/actividades/tipos.py:105 app/ui/seguimiento/reserva_actividades.py:58
msgid "Búsqueda del tesoro"
msgstr "Treasure hunt"

#: app/actividades/tipos.py:105 app/ui/seguimiento/reserva_actividades.py:58
msgid "Encontrar todos los premios escondidos por el entorno."
msgstr "Find all the rewards hidden around the environment."

#: app/actividades/tipos.py:108
msgid "El recadero"
msgstr "The errand runner"

#: app/actividades/tipos.py:109
msgid "Coger algo en un sitio y llevarlo a otro; los encargos se pueden encadenar."
msgstr "Pick something up in one place and take it to another; errands can be chained."

#: app/actividades/tipos.py:115
msgid "Sacar los tesoros"
msgstr "Get the treasures out"

#: app/actividades/tipos.py:116
msgid "Recoger los tesoros de uno en uno y sacarlos por la salida más cercana. Cada tesoro puntúa 3, 2, 1 o 0 según la salida elegida."
msgstr "Collect the treasures one at a time and take them out through the nearest exit. Each treasure scores 3, 2, 1 or 0 depending on the exit chosen."

#: app/actividades/tipos.py:122
msgid "El escondite"
msgstr "Hide and seek"

#: app/actividades/tipos.py:122
msgid "Encontrar a un personaje escondido que hace ruido de vez en cuando."
msgstr "Find a hidden character who makes a noise every now and then."

#: app/actividades/tipos.py:123
msgid "Sigue al guía"
msgstr "Follow the guide"

#: app/actividades/tipos.py:123
msgid "Seguir a un guía por el sonido de sus pasos, sin alejarse de él."
msgstr "Follow a guide by the sound of their footsteps, without falling behind."

#: app/actividades/tipos.py:126
msgid "El explorador"
msgstr "The explorer"

#: app/actividades/tipos.py:127
msgid "Descubrir todos los espacios del entorno; cada uno nuevo suena a hallazgo."
msgstr "Discover all the spaces in the environment; each new one sounds like a find."

#: app/actividades/tipos.py:133
msgid "Pistas encadenadas"
msgstr "Chained hints"

#: app/actividades/tipos.py:134
msgid "Cada premio da la pista del siguiente, redactada con las relaciones espaciales reales del entorno o escrita por el profesional."
msgstr "Each reward gives the hint to the next one, written from the real spatial relationships in the environment or by the instructor."

#: app/actividades/tipos.py:142
msgid "Cruza con el pitido"
msgstr "Cross with the beep"

#: app/actividades/tipos.py:143
msgid "En la calle: decidir cuándo cruzar, por el paso y con el semáforo a favor."
msgstr "On the street: decide when to cross, at the crosswalk and with the light in your favor."

#: app/actividades/tipos.py:150 app/reproductor/pantallas/elegir.py:138 app/reproductor/pantallas/juego.py:387 app/ui/seguimiento/reserva_actividades.py:61
msgid "Exploración libre"
msgstr "Free exploration"

#: app/actividades/tipos.py:151 app/ui/seguimiento/reserva_actividades.py:62
msgid "Recorrer el entorno con libertad, sin objetivo ni puntuación."
msgstr "Move freely around the environment, with no goal and no score."

#: app/actividades/tipos.py:157
msgid "Visita guiada"
msgstr "Guided tour"

#: app/actividades/tipos.py:158
msgid "Recorrer el entorno oyendo textos preparados en cada zona, o la narración en vivo del profesional."
msgstr "Walk through the environment hearing texts prepared for each zone, or the instructor's live narration."

#: app/actividades/tipos.py:162 app/importar/gpx.py:119 app/importar/gpx.py:159 app/seguimiento/informes.py:65 app/seguimiento/informes.py:605 app/ui/seguimiento/cuaderno.py:134 app/ui/seguimiento/reserva_actividades.py:66
msgid "Ruta"
msgstr "Route"

#: app/actividades/tipos.py:162 app/ui/seguimiento/reserva_actividades.py:66
msgid "Ir de un punto a otro, con paradas intermedias si se quiere."
msgstr "Go from one point to another, with intermediate stops if you want."

#: app/actividades/tipos.py:163 app/actividades/tipos.py:910
msgid "Ruta inversa"
msgstr "Reverse route"

#: app/actividades/tipos.py:163
msgid "Ir a un lugar y volver por donde se vino."
msgstr "Go to a place and come back the way you came."

#: app/actividades/tipos.py:166
msgid "Volver al origen"
msgstr "Return to start"

#: app/actividades/tipos.py:167
msgid "Pasar por varios lugares y regresar al punto de partida por el camino más corto."
msgstr "Visit several places and return to the starting point by the shortest way."

#: app/actividades/tipos.py:173
msgid "Ruta alternativa"
msgstr "Alternative route"

#: app/actividades/tipos.py:174
msgid "Llegar al destino con una puerta o una escalera cortadas: hay que encontrar otro camino."
msgstr "Reach the destination with a door or a staircase blocked: you have to find another way."

#: app/actividades/tipos.py:180
msgid "Localizar un espacio"
msgstr "Find a space"

#: app/actividades/tipos.py:181
msgid "Encontrar una habitación o un lugar sabiendo solo su nombre."
msgstr "Find a room or a place knowing only its name."

#: app/actividades/tipos.py:187
msgid "Familiarización de sala"
msgstr "Room familiarization"

#: app/actividades/tipos.py:188
msgid "Conocer una sala como en orientación y movilidad: primero el perímetro, después el interior."
msgstr "Get to know a room as in orientation and mobility: first the perimeter, then the interior."

#: app/actividades/tipos.py:194
msgid "Seguir una línea guía"
msgstr "Follow a shoreline"

#: app/actividades/tipos.py:195
msgid "Seguir una pared o un bordillo de un extremo a otro sin separarse."
msgstr "Follow a wall or a curb from one end to the other without moving away from it."

#: app/actividades/tipos.py:202
msgid "Examen de rutas"
msgstr "Route test"

#: app/actividades/tipos.py:203
msgid "Serie de rutas no entrenadas de dificultad comparable, con límite de tiempo. Se registra el acierto y el tiempo."
msgstr "A series of untrained routes of comparable difficulty, with a time limit. Accuracy and time are recorded."

#: app/actividades/tipos.py:210
msgid "Desde varios puntos de partida, salir por la salida más cercana. Cada salida puntúa 3, 2, 1 o 0."
msgstr "From several starting points, leave by the nearest exit. Each exit scores 3, 2, 1 or 0."

#: app/actividades/tipos.py:217
msgid "Girarse hacia un lugar que no se percibe y confirmar. Se mide el error en grados."
msgstr "Turn toward a place you cannot perceive and confirm. The error is measured in degrees."

#: app/actividades/tipos.py:223
msgid "Examen de distancias"
msgstr "Distance test"

#: app/actividades/tipos.py:224
msgid "Decidir cuál de dos lugares queda más cerca, andando o en línea recta."
msgstr "Decide which of two places is closer, walking or in a straight line."

#: app/actividades/tipos.py:230
msgid "Examen de reconstrucción"
msgstr "Reconstruction test"

#: app/actividades/tipos.py:231
msgid "Colocar las habitaciones en su posición relativa respondiendo a preguntas como «¿qué hay al norte del salón?»."
msgstr "Place the rooms in their relative positions by answering questions such as “What is north of the living room?”."

#: app/actividades/tipos.py:240 app/entrada/acciones.py:71 app/ui/seguimiento/textos.py:53
msgid "Dónde estoy"
msgstr "Where am I"

#: app/actividades/tipos.py:241 app/ui/seguimiento/textos.py:54
msgid "Descripción del lugar"
msgstr "Place description"

#: app/actividades/tipos.py:242
msgid "Mirar a los lados y atrás"
msgstr "Look to the sides and behind"

#: app/actividades/tipos.py:243 app/ui/seguimiento/textos.py:56
msgid "Qué hay delante"
msgstr "What's ahead"

#: app/actividades/tipos.py:244 app/ui/seguimiento/textos.py:57
msgid "Qué hay alrededor"
msgstr "What's around"

#: app/actividades/tipos.py:245 app/entrada/acciones.py:81 app/ui/seguimiento/textos.py:58
msgid "Bastón sonoro"
msgstr "Sound cane"

#: app/actividades/tipos.py:246
msgid "Lista de cosas cercanas"
msgstr "List of nearby things"

#: app/actividades/tipos.py:247 app/entrada/acciones.py:79 app/ui/seguimiento/textos.py:60
msgid "Lugares descubiertos"
msgstr "Discovered places"

#: app/actividades/tipos.py:248 app/entrada/acciones.py:80 app/ui/seguimiento/textos.py:61
msgid "Brújula"
msgstr "Compass"

#: app/actividades/tipos.py:249 app/entrada/acciones.py:82 app/ui/seguimiento/textos.py:62
msgid "Eco"
msgstr "Echo"

#: app/actividades/tipos.py:250
msgid "Repetir el objetivo"
msgstr "Repeat the goal"

#: app/actividades/tipos.py:251
msgid "Pedir una pista"
msgstr "Ask for a hint"

#: app/actividades/tipos.py:252 app/ui/seguimiento/textos.py:65
msgid "Baliza sonora"
msgstr "Sound beacon"

#: app/actividades/tipos.py:253
msgid "Avisos automáticos de proximidad"
msgstr "Automatic proximity alerts"

#: app/actividades/tipos.py:261 app/ui/seguimiento/presentador_actividades.py:50
msgid "Con baliza"
msgstr "With beacon"

#: app/actividades/tipos.py:262 app/ui/seguimiento/presentador_actividades.py:51
msgid "Baliza solo al pedirla"
msgstr "Beacon only on request"

#: app/actividades/tipos.py:263 app/ui/seguimiento/presentador_actividades.py:52 app/ui/seguimiento/supervision.py:84
msgid "Sin baliza"
msgstr "No beacon"

#: app/actividades/tipos.py:265 app/ui/seguimiento/presentador_actividades.py:54
msgid "Sin baliza y sin «dónde estoy»"
msgstr "No beacon and no “where am I”"

#: app/actividades/tipos.py:276 app/ui/seguimiento/reserva_actividades.py:92
msgid "El de la ficha del alumno"
msgstr "The one in the student record"

#: app/actividades/tipos.py:277 app/reproductor/textos.py:21 app/ui/esquema_preferencias.py:502 app/ui/seguimiento/reserva_actividades.py:93 app/ui/seguimiento/textos.py:23
msgid "Infantil"
msgstr "Children"

#: app/actividades/tipos.py:278 app/reproductor/textos.py:21 app/ui/esquema_preferencias.py:502 app/ui/seguimiento/reserva_actividades.py:94 app/ui/seguimiento/textos.py:23
msgid "Juvenil"
msgstr "Teen"

#: app/actividades/tipos.py:279 app/reproductor/textos.py:21 app/ui/esquema_preferencias.py:502 app/ui/seguimiento/reserva_actividades.py:95 app/ui/seguimiento/textos.py:23
msgid "Adulto"
msgstr "Adult"

#. Traductores: cabeceras de las columnas de la lista de complementos.
