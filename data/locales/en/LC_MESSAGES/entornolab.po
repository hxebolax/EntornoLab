#: app/actividades/plantillas.py:133
msgid "Búsqueda del tesoro en casa"
msgstr "Treasure hunt at home"

#: app/actividades/plantillas.py:134
msgid "Cinco tesoros escondidos por toda la casa: hay que entrar en todas las habitaciones y abrir cosas."
msgstr "Five treasures hidden all over the house: you have to go into every room and open things."

#: app/actividades/plantillas.py:140
msgid "¡Hola! Tiko ha escondido cinco tesoros por la casa. ¡Vamos a buscarlos!"
msgstr "Hi! Tiko has hidden five treasures around the house. Let's go find them!"

#: app/actividades/plantillas.py:141
msgid "¡Has encontrado todos los tesoros de la casa!"
msgstr "You found all the treasures in the house!"

#: app/actividades/plantillas.py:143
msgid "la casa del árbol"
msgstr "the tree house"

#: app/actividades/plantillas.py:149
msgid "Prepara la visita"
msgstr "Get ready to go out"

#: app/actividades/plantillas.py:150
msgid "Antes de salir de casa: localizar las llaves, el abrigo y el paraguas. Sobrio y práctico, pensado para adultos."
msgstr "Before leaving home: find the keys, the coat and the umbrella. Plain and practical, designed for adults."

#: app/actividades/plantillas.py:158
msgid "Prepara la visita: encuentra las llaves, el abrigo y el paraguas."
msgstr "Get ready to go out: find the keys, the coat and the umbrella."

#: app/actividades/plantillas.py:159
msgid "Ya lo tienes todo para salir."
msgstr "You have everything you need to go out."

#: app/actividades/plantillas.py:165
msgid "Pistas por la casa"
msgstr "Clues around the house"

#: app/actividades/plantillas.py:166
msgid "Cuatro sobres encadenados: cada uno dice dónde está el siguiente, con relaciones reales entre las habitaciones."
msgstr "Four linked envelopes: each one says where the next one is, using real relationships between the rooms."

#: app/actividades/plantillas.py:178
msgid "Conoce el salón"
msgstr "Get to know the living room"

#: app/actividades/plantillas.py:179
msgid "Familiarización de sala: primero el perímetro siguiendo la pared y después el interior."
msgstr "Room familiarization: first the perimeter, trailing the wall, and then the interior."

#: app/actividades/plantillas.py:187
msgid "Visita a la casa"
msgstr "Tour of the house"

#: app/actividades/plantillas.py:188
msgid "Un paseo por todas las estancias oyendo la descripción de cada una."
msgstr "A walk through every room, hearing a description of each one."

#: app/actividades/plantillas.py:197
msgid "el trofeo"
msgstr "the trophy"

#: app/actividades/plantillas.py:197
msgid "el mapa antiguo"
msgstr "the old map"

#: app/actividades/plantillas.py:197
msgid "la llave maestra"
msgstr "the master key"

#: app/actividades/plantillas.py:197
msgid "el globo terráqueo"
msgstr "the globe"

#: app/actividades/plantillas.py:197
msgid "el reloj de arena"
msgstr "the hourglass"

#: app/actividades/plantillas.py:205
msgid "Sacar los tesoros del centro"
msgstr "Get the treasures out of the center"

#: app/actividades/plantillas.py:206
msgid "Cinco tesoros por las dos plantas. Se sacan de uno en uno por la salida más cercana: 3, 2, 1 o 0 puntos según la salida."
msgstr "Five treasures across the two levels. Take them out one at a time through the nearest exit: 3, 2, 1 or 0 points depending on the exit."

#: app/actividades/plantillas.py:217
msgid "Examen de rutas del centro"
msgstr "Center routes test"

#: app/actividades/plantillas.py:218
msgid "Cinco rutas no entrenadas de longitud parecida, con seis minutos para cada una."
msgstr "Five untrained routes of similar length, with six minutes for each one."

#: app/actividades/plantillas.py:227 app/actividades/tipos.py:209 app/ui/seguimiento/reserva_actividades.py:69
msgid "Examen de salida más corta"
msgstr "Shortest exit test"

#: app/actividades/plantillas.py:228
msgid "Desde cinco puntos del centro, salir por la salida más cercana."
msgstr "From five points in the center, leave through the nearest exit."

#: app/actividades/plantillas.py:237 app/actividades/tipos.py:216
msgid "Examen de señalar"
msgstr "Pointing test"

#: app/actividades/plantillas.py:238
msgid "Girarse hacia cinco lugares del centro que no se perciben desde donde se está."
msgstr "Turn toward five places in the center that cannot be perceived from where you are."

#: app/actividades/plantillas.py:246
msgid "Sigue al guía hasta la biblioteca"
msgstr "Follow the guide to the library"

#: app/actividades/plantillas.py:247
msgid "Un guía lleva al alumno del vestíbulo a la biblioteca; se le sigue por el sonido de sus pasos."
msgstr "A guide takes the student from the lobby to the library; the student follows the sound of the guide's footsteps."

#: app/actividades/plantillas.py:253
msgid "Del vestíbulo a la sala de informática"
msgstr "From the lobby to the computer room"

#: app/actividades/plantillas.py:254
msgid "Ruta con cambio de planta. Las ayudas se retiran por niveles: con baliza, baliza al pedirla, sin baliza y sin «dónde estoy»."
msgstr "A route with a change of level. Help is withdrawn in levels: beacon on, beacon on request, no beacon, and no \"where am I\"."

#: app/actividades/plantillas.py:273
msgid "Un recado hasta la parada"
msgstr "An errand to the stop"

#: app/actividades/plantillas.py:274
msgid "Recoger una carta junto al buzón de correos y llevarla a la parada de autobús, cruzando las dos calles."
msgstr "Pick up a letter next to the mailbox and take it to the bus stop, crossing both streets."

#: app/actividades/plantillas.py:279
msgid "la carta"
msgstr "the letter"

#: app/actividades/plantillas.py:289
msgid "Práctica de cruce"
msgstr "Crossing practice"

#: app/actividades/plantillas.py:290
msgid "Cruzar dos veces: por el paso con semáforo sonoro y por el paso sin semáforo. Es un simulador: no dice si un cruce real es seguro."
msgstr "Cross twice: at the crosswalk with an accessible pedestrian signal and at the crosswalk without a traffic light. This is a simulator: it does not tell you whether a real crossing is safe."

#: app/actividades/plantillas.py:298
msgid "Encuentra el centro cívico"
msgstr "Find the community center"

#: app/actividades/plantillas.py:299
msgid "Llegar al vestíbulo del centro cívico sabiendo solo su nombre."
msgstr "Reach the lobby of the community center knowing only its name."

#: app/actividades/practicas.py:139
msgid "la sala"
msgstr "the room"

#: app/actividades/practicas.py:219
msgid "Busca una pared y síguela sin soltarla. Las esquinas te dicen cuándo cambias de pared."
msgstr "Find a wall and trail it without letting go. The corners tell you when you change walls."

